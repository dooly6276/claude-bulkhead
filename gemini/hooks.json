{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "bulkhead",
            "type": "command",
            "command": "node \"${extensionPath}${/}bin${/}bulkhead\" hook --agent gemini",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
